{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "db: up",
      "type": "shell",
      "command": "docker compose up -d db",
      "problemMatcher": []
    },
    {
      "label": "ibkr: gateway up",
      "type": "shell",
      "command": "docker compose --profile ibkr up -d ib-gateway",
      "problemMatcher": []
    },
    {
      "label": "ibkr: gateway vnc",
      "type": "process",
      "command": "${env:ProgramFiles}\\TigerVNC\\vncviewer.exe",
      "args": ["-SecurityTypes", "VncAuth", "127.0.0.1::5900"],
      "problemMatcher": []
    },
    {
      "label": "db: migrate",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\.vscode\\task_artifact_runner.py",
        "--artifact",
        "db-migrate",
        "--",
        "-m",
        "alembic",
        "upgrade",
        "head"
      ],
      "options": {
        "env": {
          "DATABASE_URL": "postgresql+psycopg://trader:trader@127.0.0.1:5433/ibkr_trader?connect_timeout=5"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "db: new migration",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "alembic",
        "revision",
        "--autogenerate",
        "-m",
        "${input:migrationMessage}"
      ],
      "options": {
        "env": {
          "DATABASE_URL": "postgresql+psycopg://trader:trader@127.0.0.1:5433/ibkr_trader?connect_timeout=5"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "stack: up (db + ib-gateway)",
      "type": "shell",
      "command": "docker compose --profile ibkr up -d",
      "problemMatcher": []
    },
    {
      "label": "stack: down",
      "type": "shell",
      "command": "docker compose --profile ibkr --profile app down",
      "problemMatcher": []
    },
    {
      "label": "stack: logs",
      "type": "shell",
      "command": "docker compose logs -f --tail=100",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\.vscode\\task_artifact_runner.py",
        "--artifact",
        "test",
        "--",
        "-m",
        "pytest"
      ],
      "group": { "kind": "test", "isDefault": true },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\.vscode\\task_artifact_runner.py",
        "--artifact",
        "lint",
        "--",
        "-m",
        "ruff",
        "check",
        "src",
        "tests"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "format: check",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\.vscode\\task_artifact_runner.py",
        "--artifact",
        "format-check",
        "--",
        "-m",
        "ruff",
        "format",
        "--check",
        "src",
        "tests"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\.vscode\\task_artifact_runner.py",
        "--artifact",
        "typecheck",
        "--",
        "-m",
        "mypy",
        "src"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "check: all (lint + type + test)",
      "dependsOrder": "sequence",
      "dependsOn": ["lint", "format: check", "typecheck", "test"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "agents: sync from claude",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\.vscode\\sync_claude_to_agents.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "ibkr: connection check",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\ibkr-trader.exe",
      "args": [
        "ibkr-check"
      ],
      "problemMatcher": []
    },
    {
      "label": "ingest: fmp prices (one symbol)",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\.vscode\\task_artifact_runner.py",
        "--artifact",
        "ingest-fmp-price",
        "--",
        "-m",
        "ibkr_trader.cli",
        "ingest",
        "prices",
        "${input:priceSymbol}",
        "--source",
        "fmp"
      ],
      "options": {
        "env": {
          "DATABASE_URL": "postgresql+psycopg://trader:trader@127.0.0.1:5433/ibkr_trader?connect_timeout=5"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "ingest: finnhub news (one symbol)",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\.vscode\\task_artifact_runner.py",
        "--artifact",
        "ingest-finnhub-news",
        "--",
        "-m",
        "ibkr_trader.cli",
        "ingest",
        "finnhub-news",
        "${input:newsSymbol}"
      ],
      "options": {
        "env": {
          "DATABASE_URL": "postgresql+psycopg://trader:trader@127.0.0.1:5433/ibkr_trader?connect_timeout=5"
