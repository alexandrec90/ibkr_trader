  "inputs": [
    {
      "id": "migrationMessage",
      "type": "promptString",
      "description": "Alembic migration message"
    },
    {
      "id": "priceSymbol",
      "type": "promptString",
      "description": "Ticker symbol to pull from FMP",
      "default": "NVDA"
    },
    {
      "id": "newsSymbol",
      "type": "promptString",
      "description": "Ticker symbol to pull company news from Finnhub (US names have best coverage)",
      "default": "AAPL"
    },
    {
      "id": "redditLimit",
      "type": "promptString",
      "description": "Max posts to pull per subreddit (needs REDDIT_* creds in .env)",
      "default": "100"
    },
    {
      "id": "trendsKeyword",
      "type": "promptString",
      "description": "Google Trends search term — a brand/company name, not a ticker (no API key needed)",
      "default": "Nvidia"
    },
    {
      "id": "fxPair",
      "type": "promptString",
      "description": "FX pair to pull from FMP (close = quote currency per 1 base)",
      "default": "USDCAD"
    },
    {
      "id": "btStrategy",
      "type": "pickString",
      "description": "Allocator to simulate",
      "options": ["ml_lt_ridge", "ml_lt", "momentum_lt", "equal_weight", "buy_and_hold"],
      "default": "ml_lt_ridge"
    },
    {
      "id": "btAccount",
      "type": "pickString",
      "description": "Registered account to simulate (drives US-dividend withholding)",
      "options": ["tfsa", "rrsp", "fhsa", "lira", "nonreg"],
      "default": "tfsa"
    },
    {
      "id": "btUniverseFile",
      "type": "promptString",
      "description": "Universe file (tickers.txt = stocks+ETFs, tickers-etfs.txt = ETF floor)",
      "default": "tickers.txt"
    },
    {
      "id": "btStart",
      "type": "promptString",
      "description": "Bar-load start (warm-up bars for features; USDCAD coverage starts 2003-09-17)",
      "default": "2008-06-02"
    },
    {
      "id": "btEvalStart",
      "type": "promptString",
      "description": "First decision date (owner policy floor: 2010, to skip the 2008-09 recession)",
      "default": "2010-01-04"
    },
    {
      "id": "btEnd",
      "type": "promptString",
      "description": "Window end (a far-future date just means 'through the newest bar')",
      "default": "2030-01-01"
    },
    {
      "id": "btSortBy",
      "type": "pickString",
      "description": "Leaderboard ranking metric",
      "options": ["sharpe", "calmar", "cagr", "total_return", "excess_return", "max_drawdown"],
      "default": "calmar"
    },
    {
      "id": "oosEnd",
      "type": "promptString",
      "description": "OOS dataset window end (labels stop 12 months earlier)",
      "default": "2026-07-01"
    },
    {
      "id": "trainEnd",
      "type": "promptString",
      "description": "Training dataset window end (labels stop 12 months earlier)",
      "default": "2026-07-01"
    }
  ]
}
