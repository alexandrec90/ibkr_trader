        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "tickers: aggregate universe (tickers.txt)",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\.vscode\\aggregate_tickers.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "ingest: setup db + all prices",
      "dependsOrder": "sequence",
      "dependsOn": [
        "db: up",
        "db: migrate",
        "ingest: fmp prices (tickers-fmp.txt)",
        "ingest: yahoo prices (tickers-yahoo.txt)",
        "tickers: aggregate universe (tickers.txt)"
      ],
      "problemMatcher": []
    },
    {
      "label": "snapshot: monthly",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\ibkr-trader.exe",
      "args": ["snapshot", "run", "--all"],
      "dependsOrder": "sequence",
      "dependsOn": ["ingest: setup db + all prices"],
      "options": {
        "env": {
          "DATABASE_URL": "postgresql+psycopg://trader:trader@127.0.0.1:5433/ibkr_trader?connect_timeout=5"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "todo: tidy (move done items to end)",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\.vscode\\reorder_todo.py"],
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": false },
      "problemMatcher": []
    },
    {
      "label": "app: docker build",
      "type": "shell",
      "command": "docker compose build app",
      "problemMatcher": []
    },
    {
      "label": "docker: prune + compact (max reclaim, restarts Docker)",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\.vscode\\docker_prune.py"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "migrationMessage",
      "type": "promptString",
      "description": "Alembic migration message"
    },
    {
      "id": "priceSymbol",
      "type": "promptString",
      "description": "Ticker symbol to pull from FMP",
      "default": "NVDA"
    },
    {
      "id": "newsSymbol",
      "type": "promptString",
      "description": "Ticker symbol to pull company news from Finnhub (US names have best coverage)",
      "default": "AAPL"
    },
    {
      "id": "redditLimit",
      "type": "promptString",
      "description": "Max posts to pull per subreddit (needs REDDIT_* creds in .env)",
      "default": "100"
    },
    {
      "id": "trendsKeyword",
      "type": "promptString",
      "description": "Google Trends search term — a brand/company name, not a ticker (no API key needed)",
      "default": "Nvidia"
    },
    {
      "id": "fxPair",
      "type": "promptString",
      "description": "FX pair to pull from FMP (close = quote currency per 1 base)",
      "default": "USDCAD"
    }
  ]
}
