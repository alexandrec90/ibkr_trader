{
  // Shared test, lint, git, agent-context, Docker-maintenance, port, and shipping
  // actions live in alex-projects.code-workspace. This file keeps only IBKR-specific
  // workflows where a picker/composite or GUI launch is materially better than the
  // documented CLI. Hidden tasks are implementation steps for the monthly snapshot.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Stop: Docker Stack",
      "detail": "Stop IBKR containers across the ibkr/app profiles. Named volumes and ingested bars survive.",
      "type": "shell",
      "command": "docker compose --profile ibkr --profile app down",
      "problemMatcher": []
    },
    {
      "label": "IBKR: Open Gateway VNC Viewer",
      "detail": "Attach TigerVNC to the paper gateway for login and 2FA prompts.",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\.vscode\\vnc_viewer.py", "${env:ProgramFiles}\\TigerVNC\\vncviewer.exe"],
      "problemMatcher": []
    },
    {
      "label": "Ingest: Run Source",
      "detail": "Run one source pull. The optional argument is used only by single-symbol, keyword, or FX-pair modes.",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\.vscode\\ingest_task.py", "${input:ingestSource}", "--arg", "${input:ingestArg}"],
      "options": { "env": { "DATABASE_URL": "postgresql+psycopg://trader:trader@127.0.0.1:5433/ibkr_trader?connect_timeout=5" } },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Snapshot: Run Monthly",
      "detail": "Run the monthly forward-shadow ritual: database, migrations, FMP/Yahoo prices, ticker aggregation, then snapshot run --all.",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\ibkr-trader.exe",
      "args": ["snapshot", "run", "--all"],
      "dependsOrder": "sequence",
      "dependsOn": ["Snapshot: Prepare Monthly Data"],
      "options": { "env": { "DATABASE_URL": "postgresql+psycopg://trader:trader@127.0.0.1:5433/ibkr_trader?connect_timeout=5" } },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Backtest: Run",
      "detail": "Simulate one allocator over one universe with the standing warm-up and evaluation-window defaults.",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\ibkr-trader.exe",
      "args": [
        "backtest", "run",
        "--strategy", "${input:btStrategy}",
        "--account", "${input:btAccount}",
        "--universe-file", "${input:btUniverseFile}",
        "--start", "${input:btStart}",
        "--eval-start", "${input:btEvalStart}",
        "--end", "${input:btEnd}"
      ],
      "options": { "env": { "DATABASE_URL": "postgresql+psycopg://trader:trader@127.0.0.1:5433/ibkr_trader?connect_timeout=5" } },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Backtest: OOS (Honest Per-Fold)",
      "detail": "Run the walk-forward out-of-sample evaluation; each fold trains only on data then available.",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\ibkr-trader.exe",
      "args": [
        "backtest", "oos", "--end", "${input:oosEnd}",
        "--start", "2008-06-02", "--sim-start", "2010-01-04",
        "--account", "${input:btAccount}"
      ],
      "options": { "env": { "DATABASE_URL": "postgresql+psycopg://trader:trader@127.0.0.1:5433/ibkr_trader?connect_timeout=5" } },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Snapshot: Start Postgres",
      "detail": "Hidden implementation step for the monthly snapshot.",
      "hide": true,
      "type": "shell",
      "command": "docker compose up -d db",
      "problemMatcher": []
    },
    {
      "label": "Snapshot: Apply Migrations",
      "detail": "Hidden implementation step for the monthly snapshot.",
      "hide": true,
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\.vscode\\task_artifact_runner.py", "--artifact", "db-migrate", "--", "-m", "alembic", "upgrade", "head"],
      "options": { "env": { "DATABASE_URL": "postgresql+psycopg://trader:trader@127.0.0.1:5433/ibkr_trader?connect_timeout=5" } },
      "problemMatcher": []
    },
    {
      "label": "Snapshot: Ingest Price Batches",
      "detail": "Hidden implementation step for the monthly snapshot.",
      "hide": true,
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command",
        "$i = '${workspaceFolder}\\.vscode\\ingest_task.py'; $p = '${workspaceFolder}\\.venv\\Scripts\\python.exe'; & $p $i fmp-prices-batch; $f = $LASTEXITCODE; & $p $i yahoo-prices-batch; if ($f -ne 0 -or $LASTEXITCODE -ne 0) { exit 1 }; exit 0"
      ],
      "options": { "env": { "DATABASE_URL": "postgresql+psycopg://trader:trader@127.0.0.1:5433/ibkr_trader?connect_timeout=5" } },
      "problemMatcher": []
    },
    {
      "label": "Snapshot: Aggregate Tickers",
      "detail": "Hidden implementation step for the monthly snapshot.",
      "hide": true,
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\.vscode\\aggregate_tickers.py"],
      "problemMatcher": []
    },
    {
      "label": "Snapshot: Prepare Monthly Data",
      "detail": "Hidden implementation aggregate for the monthly snapshot.",
      "hide": true,
      "dependsOrder": "sequence",
      "dependsOn": [
        "Snapshot: Start Postgres",
        "Snapshot: Apply Migrations",
        "Snapshot: Ingest Price Batches",
        "Snapshot: Aggregate Tickers"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "ingestSource",
      "type": "pickString",
      "description": "Which data source to pull",
      "options": [
        { "label": "FMP prices — batch", "value": "fmp-prices-batch" },
        { "label": "FMP prices — one symbol", "value": "fmp-price-one" },
        { "label": "Yahoo prices — batch", "value": "yahoo-prices-batch" },
        { "label": "Yahoo fundamentals — batch", "value": "yahoo-fundamentals-batch" },
        { "label": "Alpha Vantage prices — batch", "value": "alpha-vantage-batch" },
        { "label": "Finnhub news — batch", "value": "finnhub-news-batch" },
        { "label": "Finnhub news — one symbol", "value": "finnhub-news-one" },
        { "label": "NewsAPI headlines — batch", "value": "newsapi-batch" },
        { "label": "Google Trends — batch", "value": "trends-batch" },
        { "label": "Google Trends — one keyword", "value": "trends-one" },
        { "label": "Reddit", "value": "reddit" },
        { "label": "FMP FX — one pair", "value": "fmp-fx" },
        { "label": "Yahoo FX — deep-history backfill", "value": "yahoo-fx-backfill" }
      ],
      "default": "fmp-prices-batch"
    },
    {
      "id": "ingestArg",
      "type": "promptString",
      "description": "Optional symbol, keyword, or FX pair for single-item modes",
      "default": ""
    },
    {
      "id": "btStrategy",
      "type": "pickString",
      "description": "Allocator to simulate",
      "options": ["ml_lt_ridge", "ml_lt", "momentum_lt", "equal_weight", "buy_and_hold"],
      "default": "ml_lt_ridge"
    },
    {
      "id": "btAccount",
      "type": "pickString",
      "description": "Registered account to simulate",
      "options": ["tfsa", "rrsp", "fhsa", "lira", "nonreg"],
      "default": "tfsa"
    },
    {
      "id": "btUniverseFile",
      "type": "pickString",
      "description": "Universe file",
      "options": [
        { "label": "tickers-etfs.txt — ETF floor", "value": "tickers-etfs.txt" },
        { "label": "tickers.txt — stocks + ETFs", "value": "tickers.txt" }
      ],
      "default": "tickers-etfs.txt"
    },
    {
      "id": "btStart",
      "type": "promptString",
      "description": "Bar-load start",
      "default": "2008-06-02"
    },
    {
      "id": "btEvalStart",
      "type": "promptString",
      "description": "First decision date",
      "default": "2010-01-04"
    },
    {
      "id": "btEnd",
      "type": "promptString",
      "description": "Window end",
      "default": "2030-01-01"
    },
    {
      "id": "oosEnd",
      "type": "promptString",
      "description": "OOS dataset window end",
      "default": "2026-07-01"
    }
  ]
}
