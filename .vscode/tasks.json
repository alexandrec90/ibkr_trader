{
  // Keep this palette SMALL. Shared test, lint, git, agent-context, stack start/stop,
  // Docker-maintenance, port, and shipping actions all live in
  // alex-projects.code-workspace, defined once and taking the project as an argument.
  //
  // THE BAR FOR A TASK IN THIS FILE: a picker, a composite, or a GUI launch has to add
  // something a workspace task with `--project` cannot. A one-line invocation of a
  // documented script does NOT qualify — the script is already the interface.
  // Applying that bar took this file from eleven tasks to four:
  //
  //   - "Stop: Docker Stack" became the workspace's "Docker: Stop Stack", which
  //     delegates to the new scripts/docker-down.py. The profile handling lives there
  //     now instead of in a task string. The old task shared its label with carameli's
  //     and ran a different command, so what "Stop" meant depended on the window.
  //   - "Snapshot: Run Monthly" and its FIVE hidden steps ("Start Postgres", "Apply
  //     Migrations", "Ingest Price Batches", "Aggregate Tickers", "Prepare Monthly
  //     Data") are now one call to scripts/snapshot-monthly.py. The sequence was a
  //     dependsOn chain whose ingest link was a pwsh one-liner doing $LASTEXITCODE
  //     arithmetic inside a JSON string — a shell script in a task costume, and
  //     unreadable as a ritual because five of the six entries were hidden.
  //
  // There is no "Docker: Start Stack" equivalent here on purpose: CLAUDE.md keeps
  // containers OFF by default on this machine, so the workspace task delegates to a
  // scripts/docker-up.py this project deliberately does not ship. Start the one
  // container a command needs, then put it back down.
  //
  // DATABASE_URL is no longer repeated in every entry. It was inlined five times,
  // credentials included; the scripts resolve it once and the environment wins.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "IBKR: Open Gateway VNC Viewer",
      "detail": "Attach TigerVNC to the paper gateway for login and 2FA prompts. Earns its place: launching a GUI is something no CLI-shaped workspace task can do.",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\scripts\\vnc-viewer.py", "${env:ProgramFiles}\\TigerVNC\\vncviewer.exe"],
      "problemMatcher": []
    },
    {
      "label": "Ingest: Run Source",
      "detail": "Run one source pull. The optional argument is used only by single-symbol, keyword, or FX-pair modes. Earns its place: a thirteen-way picker over source names is materially faster than recalling the flag.",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\scripts\\ingest-task.py", "${input:ingestSource}", "--arg", "${input:ingestArg}"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Snapshot: Run Monthly",
      "detail": "The whole monthly forward-shadow ritual in one step: Postgres up, migrations, FMP + Yahoo prices, ticker aggregation, then `snapshot run --all`. Stops at the first unrecoverable failure and writes it to artifacts/tasks/snapshot-monthly.log — read the artifact, not the terminal. Starts a container; it does NOT stop it afterwards.",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\scripts\\snapshot-monthly.py", "${input:snapshotScope}"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Backtest: Run",
      "detail": "Simulate one allocator over one universe. Earns its place: six inputs, four of them pickers over registered accounts and universe files.",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\ibkr-trader.exe",
      "args": [
        "backtest", "run",
        "--strategy", "${input:btStrategy}",
        "--account", "${input:btAccount}",
        "--universe-file", "${input:btUniverseFile}",
        "--start", "${input:btStart}",
        "--eval-start", "${input:btEvalStart}",
        "--end", "${input:btEnd}"
      ],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Backtest: OOS (Honest Per-Fold)",
      "detail": "Walk-forward out-of-sample evaluation; each fold trains only on data then available. The warm-up and simulation starts are fixed here deliberately — an OOS run whose windows move is not comparable to the last one.",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\ibkr-trader.exe",
      "args": [
        "backtest", "oos", "--end", "${input:oosEnd}",
        "--start", "2008-06-02", "--sim-start", "2010-01-04",
        "--account", "${input:btAccount}"
      ],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "ingestSource",
      "type": "pickString",
      "description": "Which data source to pull",
      "options": [
        { "label": "FMP prices — batch", "value": "fmp-prices-batch" },
        { "label": "FMP prices — one symbol", "value": "fmp-price-one" },
        { "label": "Yahoo prices — batch", "value": "yahoo-prices-batch" },
        { "label": "Yahoo fundamentals — batch", "value": "yahoo-fundamentals-batch" },
        { "label": "Alpha Vantage prices — batch", "value": "alpha-vantage-batch" },
        { "label": "Finnhub news — batch", "value": "finnhub-news-batch" },
        { "label": "Finnhub news — one symbol", "value": "finnhub-news-one" },
        { "label": "NewsAPI headlines — batch", "value": "newsapi-batch" },
        { "label": "Google Trends — batch", "value": "trends-batch" },
        { "label": "Google Trends — one keyword", "value": "trends-one" },
        { "label": "Reddit", "value": "reddit" },
        { "label": "FMP FX — one pair", "value": "fmp-fx" },
        { "label": "Yahoo FX — deep-history backfill", "value": "yahoo-fx-backfill" }
      ],
      "default": "fmp-prices-batch"
    },
    {
      "id": "ingestArg",
      "type": "promptString",
      "description": "Optional symbol, keyword, or FX pair for single-item modes",
      "default": ""
    },
    {
      // Every branch supplies one real token — `--full` is redundant against the
      // script's default and exists for exactly that reason. An empty option does not
      // vanish from the args array; it reaches argparse as a stray positional.
      "id": "snapshotScope",
      "type": "pickString",
      "description": "Full ritual, or re-run just the snapshot over data already ingested?",
      "options": [
        { "label": "Full ritual — migrations, prices, aggregation, snapshot", "value": "--full" },
        { "label": "Snapshot only — skip the price ingests", "value": "--skip-ingest" },
        { "label": "Dry run — print the plan, run nothing", "value": "--dry-run" }
      ],
      "default": "--full"
    },
    {
      "id": "btStrategy",
      "type": "pickString",
      "description": "Allocator to simulate",
      "options": ["ml_lt_ridge", "ml_lt", "momentum_lt", "equal_weight", "buy_and_hold"],
      "default": "ml_lt_ridge"
    },
    {
      "id": "btAccount",
      "type": "pickString",
      "description": "Registered account to simulate",
      "options": ["tfsa", "rrsp", "fhsa", "lira", "nonreg"],
      "default": "tfsa"
    },
    {
      "id": "btUniverseFile",
      "type": "pickString",
      "description": "Universe file",
      "options": [
        { "label": "tickers-etfs.txt — ETF floor", "value": "tickers-etfs.txt" },
        { "label": "tickers.txt — stocks + ETFs", "value": "tickers.txt" }
      ],
      "default": "tickers-etfs.txt"
    },
    {
      "id": "btStart",
      "type": "promptString",
      "description": "Bar-load start",
      "default": "2008-06-02"
    },
    {
      "id": "btEvalStart",
      "type": "promptString",
      "description": "First decision date",
      "default": "2010-01-04"
    },
    {
      "id": "btEnd",
      "type": "promptString",
      "description": "Window end",
      "default": "2030-01-01"
    },
    {
      "id": "oosEnd",
      "type": "promptString",
      "description": "OOS dataset window end",
      "default": "2026-07-01"
    }
  ]
}
