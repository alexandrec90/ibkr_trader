# Copy to .env and fill in. NEVER commit .env.

# dev | paper | live  (live additionally requires LIVE_TRADING_ACKNOWLEDGED=true)
ENVIRONMENT=paper
LIVE_TRADING_ACKNOWLEDGED=false

# --- PostgreSQL ---------------------------------------------------------
DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5433/ibkr_trader
# When the app itself runs inside docker compose, use host "db":
# DATABASE_URL=postgresql+psycopg://trader:trader@db:5432/ibkr_trader
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader
POSTGRES_DB=ibkr_trader

# --- IBKR / IB Gateway --------------------------------------------------
# Ports: TWS live 7496 / paper 7497 · IB Gateway live 4001 / paper 4002
#        gnzsnz docker image forwards: live 4003 / paper 4004
IBKR_HOST=127.0.0.1
IBKR_PORT=4004
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=            # paper account id, starts with DU
# Credentials consumed by the ib-gateway container (docker-compose.yml)
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=paper
READ_ONLY_API=yes        # flip to "no" only when execution work starts
VNC_SERVER_PASSWORD=

# --- Data source API keys (see docs/data-sources.md) ---------------------
NEWSAPI_KEY=
FINNHUB_KEY=
ALPHA_VANTAGE_KEY=
FMP_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ibkr-trader/0.1 by u/<your-reddit-username>
