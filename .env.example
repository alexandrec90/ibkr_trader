# Copy to .env and fill in. NEVER commit .env.

# dev | paper | live  (live additionally requires LIVE_TRADING_ACKNOWLEDGED=true)
ENVIRONMENT=paper
LIVE_TRADING_ACKNOWLEDGED=false

# --- PostgreSQL ---------------------------------------------------------
DATABASE_URL=postgresql+psycopg://trader:trader@127.0.0.1:5433/ibkr_trader
# When the app itself runs inside docker compose, use host "db":
# DATABASE_URL=postgresql+psycopg://trader:trader@db:5432/ibkr_trader
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader
POSTGRES_DB=ibkr_trader

# --- IBKR / IB Gateway --------------------------------------------------
# Ports: TWS live 7496 / paper 7497 · IB Gateway live 4001 / paper 4002
#        gnzsnz docker image forwards: live 4003 / paper 4004
IBKR_HOST=127.0.0.1
IBKR_PORT=4004
IBKR_CLIENT_ID=1
# Separate simulated account shown in Client Portal > Settings > Paper Trading Account.
IBKR_PAPER_ACCOUNT=      # starts with DU; the only execution target while ENVIRONMENT=paper
# Funded-account references (never execution targets while this project is paper-only).
# "margin" is the non-registered individual account and maps to strategy account "nonreg".
IBKR_MARGIN_ACCOUNT=
IBKR_RRSP_ACCOUNT=
IBKR_TFSA_ACCOUNT=
IBKR_FHSA_ACCOUNT=
# IBKR_LIRA_ACCOUNT=     # only if a LIRA is added later
# Paper credentials consumed by the ib-gateway container (docker-compose.yml).
# Compose maps these to the generic variable names expected by the image in paper mode.
TWS_USERID_PAPER=
TWS_PASSWORD_PAPER=
TRADING_MODE=paper
READ_ONLY_API=yes        # flip to "no" only when execution work starts
VNC_SERVER_PASSWORD=

# --- Data source API keys (see docs/reference/data-sources.md) ---------------------
# For news/social ingestion you need FINNHUB_KEY (finnhub.io) + the REDDIT_* trio
# (reddit.com/prefs/apps → create a "script" app). NEWSAPI_KEY (newsapi.org) powers
# `ingest news` (keyword headline search, ~100 req/day free). ALPHA_VANTAGE_KEY powers
# `ingest prices --source alpha_vantage` (daily OHLCV, ~25 req/day free — backfills only).
NEWSAPI_KEY=
FINNHUB_KEY=
ALPHA_VANTAGE_KEY=
FMP_KEY=                 # never commit a real key here — put it in .env only
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ibkr-trader/0.1 by u/<your-reddit-username>

# --- `serve` scheduler cadence (optional; all have defaults) --------------
# Periodic ingestion + raw pruning. Nothing runs unless `ibkr-trader serve` is started.
# POLL_REDDIT_MINUTES=30
# POLL_FINNHUB_NEWS_HOURS=6
# POLL_TRENDS_HOURS=24
# PRUNE_RAW_HOURS=24
# FINNHUB_BACKFILL_HOURS=24       # walk company-news history back to the rolling floor
# FINNHUB_BACKFILL_DAYS=365       # floor depth; Finnhub's free tier serves ~1 year
# FINNHUB_BACKFILL_CHUNK_DAYS=30  # window size; capped-looking windows split automatically
# FINNHUB_BACKFILL_MAX_REQUESTS=2000  # per-run API budget; remainder resumes next run
# SENTIMENT_MODEL=vader           # vader | finbert (download FinBERT before selecting it)
# SCORE_SENTIMENT_MINUTES=60      # score news/social rows where sentiment IS NULL
# POLL_PRICES_HOURS=24            # incremental Yahoo bar refresh + FX (also on startup)
# FX_PAIRS=["USDCAD"]             # FX pairs the price poll keeps current (JSON list)
# PRUNE_RAW_MIN_AGE_DAYS=0        # drop raw as soon as sentiment is scored; raise for a grace
# NEWS_UNIVERSE_FILE=tickers.txt  # symbols the finnhub-news poll iterates
# TRENDS_KEYWORDS=["Tesla","Apple"]  # JSON list; ad-hoc fallback for the trends poll
# TRENDS_MAPPING_FILE=trends-keywords.txt  # 'TICKER,search term' lines; preferred when present

# --- Cold-data archive (docs/operations/remote-archive.md) ---------------------------
# Offload intraday bars + scored raw payloads as Parquet to object storage.
# none (default) | local (a directory, e.g. an external drive) | s3 (any S3-compatible
# service: Cloudflare R2, Backblaze B2, MinIO, AWS). The bucket MUST be private —
# social payloads never go anywhere public (Québec Law 25).
ARCHIVE_BACKEND=none
ARCHIVE_LOCAL_DIR=archive
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ENDPOINT_URL=        # R2: https://<account-id>.r2.cloudflarestorage.com
ARCHIVE_S3_REGION=auto          # R2 uses the literal region "auto"
ARCHIVE_S3_ACCESS_KEY_ID=       # never commit real keys — .env only
ARCHIVE_S3_SECRET_ACCESS_KEY=
ARCHIVE_S3_PREFIX=              # optional key prefix inside the bucket
# Offload windows + cadence for the `serve` archive jobs (both no-op while ARCHIVE_BACKEND=none).
# ARCHIVE_BARS_OLDER_THAN_DAYS is the hot/cold boundary and the knob that bounds local disk;
# it is also the default for `archive bars` when --older-than-days is omitted. Daily bars are
# never archived, so lowering it does not affect training or backtests.
ARCHIVE_BARS_OLDER_THAN_DAYS=90
ARCHIVE_BARS_HOURS=24
ARCHIVE_RAW_MIN_AGE_DAYS=30
ARCHIVE_RAW_HOURS=24

# --- Registered-account long-term strategy (docs/registered-account-strategy.md) ---
BASE_CURRENCY=CAD
DEFAULT_ACCOUNT=tfsa            # rrsp | tfsa | fhsa | lira | nonreg
ANNUAL_TRADE_BUDGET=100         # per account, buys + sells (hard cap)
REBALANCE_BAND=0.05             # only trade when a weight drifts past this
MIN_PRICE=5.0                   # penny-stock floor
MIN_AVG_DOLLAR_VOLUME=1000000   # liquidity floor (CAD)
US_DIVIDEND_YIELD_ASSUMPTION=0.015
CHURN_PENALTY_BPS=10.0
FX_CONVERSION_BPS=20.0          # CAD<->USD conversion spread when shifting the currency mix
BENCHMARK_SYMBOL=XEQT
ML_LT_MODEL_DIR=models/ml_lt    # trained ml_lt artifacts (train run writes <vN>/ + latest)
