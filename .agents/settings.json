{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(alembic:*)",
      "Bash(pip install:*)",
      "Bash(python -m:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "PowerShell(pytest:*)",
      "PowerShell(ruff:*)",
      "PowerShell(mypy:*)",
      "PowerShell(alembic:*)",
      "PowerShell(pip install:*)",
      "PowerShell(python -m:*)",
      "PowerShell(docker compose config:*)",
      "PowerShell(docker compose ps:*)",
      "PowerShell(docker compose logs:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(./**/.env)"
    ]
  },

  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "model": "opus"
}
